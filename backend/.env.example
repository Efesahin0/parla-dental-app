# Copy as backend/.env only if running backend without Docker Compose.
# Do NOT commit backend/.env to GitHub.
NODE_ENV=development
SERVICE_NAME=parla-dental-backend
BUILD_VERSION=local-node
PORT=4000

DATABASE_URL=postgresql://parla_user:change_me_local_postgres_password@localhost:5433/parla_dental
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

JWT_SECRET=change_me_to_a_long_random_jwt_secret_for_local_node
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000

ADMIN_PASSWORD=change_me_admin_password
DENTIST_PASSWORD=change_me_dentist_password

AUTO_MIGRATE=true
LOG_SQL=false

REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
GOOGLE_REVIEWS_CACHE_TTL_SECONDS=1800

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_SEARCH_QUERY=Mutludent Ağız ve Diş Sağlığı Polikliniği, Çağlayan, Tıp Fakültesi Cd. 254/a, 06630 Mamak/Ankara
GOOGLE_REVIEWS_LANGUAGE=tr
GOOGLE_REVIEWS_MAX=3
GOOGLE_MAPS_URL=https://maps.app.goo.gl/tEccPQAjQFgCWiNW9?g_st=iw

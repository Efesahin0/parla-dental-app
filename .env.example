# Copy this file as .env for local Docker Compose usage.
# Do NOT commit .env to GitHub.

# PostgreSQL local demo values. Change before any real deployment.
POSTGRES_DB=parla_dental
POSTGRES_USER=parla_user
POSTGRES_PASSWORD=change_me_local_postgres_password
DATABASE_URL=postgresql://parla_user:change_me_local_postgres_password@postgres:5432/parla_dental

# Backend runtime config
NODE_ENV=production
SERVICE_NAME=parla-dental-backend
BUILD_VERSION=local-compose
PORT=4000
JWT_SECRET=change_me_to_a_long_random_jwt_secret_for_local_demo
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000

# Demo account passwords. These seed the local users during migration.
ADMIN_PASSWORD=change_me_admin_password
DENTIST_PASSWORD=change_me_dentist_password

# Local demo migration/logging
AUTO_MIGRATE=true
LOG_SQL=false

# Redis caching
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
GOOGLE_REVIEWS_CACHE_TTL_SECONDS=1800

# Optional Google integrations. Keep real keys only in .env / CI credentials, never in GitHub.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_SEARCH_QUERY=Mutludent Ağız ve Diş Sağlığı Polikliniği, Çağlayan, Tıp Fakültesi Cd. 254/a, 06630 Mamak/Ankara
GOOGLE_REVIEWS_LANGUAGE=tr
GOOGLE_REVIEWS_MAX=3
GOOGLE_MAPS_URL=https://maps.app.goo.gl/tEccPQAjQFgCWiNW9?g_st=iw
